PORT=3000
# El panel también llama al backend de la app (Click-Serve-Back, puerto 3001) para técnicos, retiros,
# incidencias y configuración. Los dos backends deben usar la MISMA base de datos y el MISMO JWT_SECRET:
# así la sesión del administrador vale en ambos.
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_HOST=localhost
DB_PORT=5436
DB_NAME=clickyserve_db

# ── JWT Authentication Secret (igual al de Click-Serve-Back) ──
JWT_SECRET=tu_jwt_secret_super_seguro

# ── Nodemailer / SMTP (Gmail, SendGrid, Mailtrap, etc.) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_password_de_aplicacion
EMAIL_FROM="Click & Serve Soporte" <tu_correo@gmail.com>

# ── Twilio SMS API ──
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio
TWILIO_PHONE_NUMBER=+1234567890

# Solo desarrollo: permite el login admin aunque falle el envío del correo 2FA
DEV_SKIP_EMAIL=false
