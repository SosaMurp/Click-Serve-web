# Copia este archivo como .env y llena los valores. No subas .env al repositorio.
PORT=3000
# development habilita sandbox de pagos, códigos en consola y llaves de respaldo.
# Sin NODE_ENV (o con production) todo eso queda apagado y faltar una llave detiene la función.
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=clickyserve_db

# Seguridad (obligatorias en producción)
JWT_SECRET=cambia-esta-llave-larga-y-aleatoria
FILES_SECRET=otra-llave-larga-y-aleatoria

# Correo para códigos de verificación (sin estos valores: en development se imprimen en consola; fuera de development no se envían)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SERVICE=gmail  o  SMTP_HOST / SMTP_PORT / SMTP_SECURE

# SMS para recuperación por SMS (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Pagos con Conekta (sin llave privada: en development los cargos son SANDBOX; fuera de development se rechazan)
CONEKTA_PRIVATE_KEY=

# Servicio biométrico (biometric-service/) y consulta de cédulas SEP
BIOMETRIC_SERVICE_URL=http://127.0.0.1:8000
# SEP_URL=https://www.cedulaprofesional.sep.gob.mx/cedula/buscaCedulaJson.action

# Inicio con Google y Apple (sin valor quedan apagados y la app oculta el botón)
# IDs de cliente OAuth de Google Cloud (web, Android, iOS), separados por comas.
GOOGLE_CLIENT_IDS=
# Bundle ID de iOS registrado en Apple Developer con "Sign in with Apple".
APPLE_BUNDLE_ID=

# Validación de la INE contra la lista nominal con un proveedor externo (apagado si está vacío).
# Sin estos valores la credencial se verifica con el sistema propio (OCR, CURP y MRZ).
INE_PROVIDER=
INE_PROVIDER_KEY=

# Detrás de un balanceador o proxy (Render, Nginx en otro host…): número de saltos de confianza, p. ej. 1.
# Sin valor solo se confía en un proxy local y todos los usuarios compartirían la IP del proxy en los límites.
# TRUST_PROXY=1

# Base de datos en un servidor remoto por túnel SSH (npm run tunel, en otra terminal).
# Con el túnel abierto: DB_HOST=127.0.0.1 y DB_PORT=TUNNEL_LOCAL_PORT. SSH_KEY es opcional (ruta a la llave).
# SSH_HOST=
# SSH_USER=ubuntu
# SSH_PORT=22
# SSH_KEY=
# TUNNEL_LOCAL_PORT=15432
# TUNNEL_REMOTE_HOST=localhost
# TUNNEL_REMOTE_PORT=5432

# false = el arranque no aplica migraciones (para una base con datos que aún no se revisa).
# Se aplican a mano con npm run db:migrate.
# DB_AUTO_MIGRATE=false

# Base con el esquema de la app contra la que compara npm run db:revisar (p. ej. clickyserve_test).
# REF_DB_HOST=localhost
# REF_DB_PORT=5432
# REF_DB_USER=postgres
# REF_DB_PASSWORD=
# REF_DB_NAME=clickyserve_test

# Dirección del panel de administración; se incluye en el correo de bienvenida de los coadministradores.
# PANEL_URL=https://admin.clickserve.mx

# Orígenes web que pueden llamar a la API desde el navegador (el panel), separados por comas.
# Sin valor se acepta cualquiera. Ejemplo: CORS_ORIGINS=https://admin.clickserve.mx
# CORS_ORIGINS=

# 1 = responde 503 en toda la API (mantenimiento)
MAINTENANCE=0
